#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mouse_layer: mouse_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_LAYER";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
        };

        mousekp_kp: mousekp_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSEKP_KP";
            bindings = <&mkp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
        };

        kp_mousekp: kp_mousekp {
            compatible = "zmk,behavior-hold-tap";
            label = "KP_MOUSEKP";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp W             &kp E                   &kp LEFT_PARENTHESIS  &kp I  &kp RIGHT_PARENTHESIS                                                                                              &kp F  &kp S  &kp Y                &kp H                  &kp P
&kp A             &kp U                   &kp X                 &kp C  &kp O                                                                                                              &kp R  &kp K  &kp T                &kp D                  &kp N
&kp Q             &mt AMPERSAND QUESTION  &kp J                 &kp V  &lt 4 COMMA                                                                                                        &kp Z  &kp G  &kp B                &kp L                  &kp M
&lt 6 LANGUAGE_2  &kp LG(Z)               &kp LS(LG(Z))                                       &mt LEFT_SHIFT PERIOD  &kp SPACE  &mkp MB1  &mouse_layer 5 MB1  &lt 3 ENTER  &kp BACKSPACE                &mt RIGHT_ALT MINUS  &mt RIGHT_CONTROL TAB  &mt RIGHT_COMMAND LANG1
            >;
        };

        AML {
            bindings = <
&trans  &trans    &trans    &trans  &trans                                                                                                &mkp MB4            &mkp MB5             &kp RG(W)                         &kp RS(RG(NUMBER_2))               &kp RC(RG(A))
&trans  &trans    &trans    &trans  &trans                                                                                                &kp RS(RC(TAB))     &kp RC(TAB)          &kp RG(T)                         &kp RS(RC(NUMBER_1))               &kp RG(LEFT_ARROW)
&trans  &trans    &trans    &trans  &mo 4                                                                                                 &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &kp RS(RG(NUMBER_4))              &kp RS(RG(V))                      &kp RG(M)
&trans  &mkp MB4  &mkp MB5                  &kp_mousekp LEFT_SHIFT MB3  &mousekp_kp MB2 SPACE  &mkp MB1  &mkp MB1  &lt 3 ENTER  &mkp MB2                                           &mt (RA(RG(UP_ARROW))) RG(MINUS)  &mt (RA(RG(DOWN_ARROW))) RG(PLUS)  &trans
            >;
        };

        MouseLayer {
            bindings = <
&trans  &trans    &trans    &trans  &trans                                                                                                &mkp MB4            &mkp MB5       &kp RG(W)                   &kp RS(RG(NUMBER_2))         &kp RC(RG(A))
&trans  &trans    &trans    &trans  &trans                                                                                                &kp RS(RC(TAB))     &kp RC(TAB)    &kp RG(T)                   &kp RS(RG(NUMBER_1))         &kp RG(LEFT)
&trans  &trans    &trans    &trans  &mo 4                                                                                                 &kp RC(LEFT_ARROW)  &kp RC(RIGHT)  &kp RS(RG(NUMBER_4))        &kp RS(RG(V))                &kp RG(M)
&trans  &mkp MB4  &mkp MB5                  &kp_mousekp LEFT_SHIFT MB3  &mousekp_kp MB2 SPACE  &mkp MB1  &mkp MB1  &lt 3 ENTER  &mkp MB2                                     &mt (RA(RG(UP))) RG(MINUS)  &mt (RA(RG(DOWN))) RG(PLUS)  &trans
            >;
        };

        Scroll {
            bindings = <
&kp ESCAPE     &mt HOME END          &kp GLOBE      &kp C           &kp LC(LG(A))                                                             &mt HOME END           &kp RS(LEFT_ARROW)  &kp RS(UP_ARROW)    &kp RS(RIGHT_ARROW)  &kp RC(RG(A))
&kp RG(L)      &kp LS(LG(F))         &kp LS(LG(X))  &msc SCRL_UP    &kp LG(LEFT_ARROW)                                                        &kp RC(RIGHT_COMMAND)  &kp UP_ARROW        &kp RS(DOWN_ARROW)  &none                &kp RC(LEFT_ARROW)
&kp LS(LG(V))  &kp LS(LG(NUMBER_4))  &kp LS(LG(F))  &msc SCRL_DOWN  &trans                                                                    &kp LEFT_ARROW         &kp DOWN_ARROW      &kp RIGHT_ARROW     &kp RS(RC(L))        &none
&trans         &kp LG(MINUS)         &kp LG(PLUS)                                       &mkp MB3  &mkp MB2  &mkp MB1  &trans  &trans  &trans                                             &trans              &trans               &trans
            >;
        };

        Numbers {
            bindings = <
&kp RS(NUMBER_1)  &kp RS(NUMBER_2)  &kp RS(NUMBER_9)  &kp RS(NUMBER_5)  &kp RS(NUMBER_0)                                                  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp EQUAL     &kp INTERNATIONAL_3
&kp RS(NUMBER_3)  &kp RS(NUMBER_4)  &kp RG(SLASH)     &kp KP_MULTIPLY   &kp RS(NUMBER_6)                                                  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp COLON     &kp TILDE
&kp RS(NUMBER_7)  &kp RS(NUMBER_8)  &kp PLUS          &kp MINUS         &trans                                                            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0  &kp DOT
&trans            &trans            &kp RG(Y)                                             &trans  &trans  &trans  &trans  &trans  &trans                              &trans        &trans        &trans
            >;
        };

        Symbols {
            bindings = <
&kp ESCAPE         &kp LEFT_BRACE         &kp LEFT_BRACKET   &kp RIGHT_BRACE  &kp RIGHT_BRACKET                                                              &mkp MB4            &mkp MB5             &kp RG(W)                         &kp RS(RG(NUMBER_2))               &kp RC(RG(A))
&kp DOUBLE_QUOTES  &kp SEMICOLON          &kp BACKSLASH      &kp COLON        &kp CARET                                                                      &kp RS(RC(TAB))     &kp RC(TAB)          &kp RG(T)                         &kp RS(RG(NUMBER_1))               &kp RG(LEFT_ARROW)
&kp SQT            &kp GRAVE              &kp EQUAL          &kp UNDERSCORE   &kp LESS_THAN                                                                  &kp RC(LEFT_ARROW)  &kp RC(RIGHT_ARROW)  &kp RS(RG(NUMBER_4))              &kp RS(RG(V))                      &kp RG(M)
&trans             &kp RG(RIGHT_BRACKET)  &kp RG(BACKSLASH)                                      &kp GREATER_THAN  &trans  &trans  &trans  &trans  &mkp MB2                                           &mt (RG(RA(UP_ARROW))) RG(MINUS)  &mt (RA(RG(DOWN_ARROW))) RG(PLUS)  &trans
            >;
        };

        Bluetooth-Others {
            bindings = <
&bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2    &bt BT_SEL 1    &bt BT_SEL 0                                                                                                                              &kp RA(RC(R))             &kp RC(RG(LEFT_ARROW))  &kp RC(RG(UP_ARROW))     &kp RC(RG(RIGHT_ARROW))  &none
&none         &none         &none           &none           &none                                                                                                                                     &kp RS(RA(RC(UP_ARROW)))  &kp RA(RC(UP_ARROW))    &kp RC(RG(DOWN_ARROW))   &kp C_VOLUME_DOWN        &kp C_VOLUME_UP
&none         &none         &none           &bt BT_CLR_ALL  &bt BT_CLR                                                                                                                                &kp RA(RC(LEFT_ARROW))    &kp RA(RC(DOWN_ARROW))  &kp RA(RC(RIGHT_ARROW))  &kp C_BRI_DN             &kp C_BRI_UP
&trans        &bootloader   &studio_unlock                                &none  &kp LS(LA(LG(LEFT_CONTROL)))  &kp LA(LG(LEFT_CONTROL))  &kp RC(RG(ENTER))  &kp RA(RG(ENTER))  &kp RA(RC(BACKSPACE))                                                    &trans                   &trans                   &trans
            >;
        };
    };
};
